# everybadge.org security headers. Same posture as thebenmeadows.com, with the
# allowlist cut to what this site actually talks to.
#
# img-src / media-src / connect-src name four origins beyond 'self':
#   data.everybadge.org      the R2 hot tier (index, cindex, meta, thumbs, anim)
#   vps3.mdws.me             IPFS fallback  } the gateways app.js tries, in
#   ipfs.filebase.io         IPFS fallback  } that order (see GATEWAYS there)
#   gateway.pinata.cloud     IPFS fallback  }
# ipfs.io and dweb.link are deliberately absent: they refuse browser requests.
#
# HSTS is set at the zone level, not here - the preload submission needs the
# zone header, and _headers cannot override a Cloudflare zone setting anyway.
#
# scripts/build-ipfs.py copies this CSP into a <meta> tag for the IPFS build,
# where no host reads this file; keep it on one line under /*.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://data.everybadge.org https://vps3.mdws.me https://ipfs.filebase.io https://gateway.pinata.cloud; media-src 'self' https://data.everybadge.org https://vps3.mdws.me https://ipfs.filebase.io https://gateway.pinata.cloud; connect-src 'self' https://data.everybadge.org https://vps3.mdws.me https://ipfs.filebase.io https://gateway.pinata.cloud; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/app.js
  Cache-Control: public, max-age=3600

/style.css
  Cache-Control: public, max-age=3600

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
