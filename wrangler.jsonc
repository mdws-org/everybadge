// everybadge.org - a Cloudflare Worker serving static assets plus one rewrite.
//
// Why a Worker and not a Pages project: Pages cannot serve non-root routes, so a
// versioned API under /v1/* (planned for the iOS client) would have needed a
// second hostname. Workers with static assets serve the shell and any future
// routes from one deployment. Decided 2026-08-18.
//
// The apex is bound here as a Custom Domain, which is why no apex DNS record
// may exist before the first deploy: Cloudflare refuses a Custom Domain on a
// hostname that already carries a CNAME.
//
// Assets live in public/ rather than the repo root so that .git, worker.js and
// this file are structurally out of scope. An .assetsignore listing them worked,
// but "the uploader is told to skip them" is a weaker guarantee than "they are
// not in the directory": a dry run reported reading 109 files from a tree that
// holds 67, and rather than explain the discrepancy the ambiguity was removed.
//
// Nothing here touches the corpus. Data is served from R2 at data.everybadge.org
// (see ~/.config/architect/tofu/everybadge-data.tf), and this Worker never
// proxies it - the browser fetches DATA directly, and the CSP in _headers names
// that one extra origin.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everybadge",
  "main": "./worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Honest 404s. /event/<id> is the one path with no file behind it, and
    // worker.js rewrites exactly that; every other miss is a real 404.
    "not_found_handling": "404-page",
    // REQUIRED for /event/<id> to work in a browser. Since compatibility date
    // 2025-04-01, navigation requests (Sec-Fetch-Mode: navigate) are served by
    // the asset router BEFORE the Worker script runs, so /event/123 matched no
    // asset and got 404.html while curl - which sends no such header - got 200.
    // Every real visitor saw a 404 and every curl check passed. Scoped to
    // /event/* so ordinary asset requests still bypass the Worker and do not
    // burn Worker invocations against the account-wide free-plan cap.
    "run_worker_first": ["/event/*"],
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "everybadge.org", "custom_domain": true },
    { "pattern": "www.everybadge.org", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}
